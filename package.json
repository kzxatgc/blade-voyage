{
  "private": true,
  "name": "blade-voyage",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "generate:levels": "node tools/generate-level-map-manifest.mjs",
    "build": "npm run generate:levels && vite build",
    "deploy": "npm run test:types && npm run lint && devvit upload",
    "dev": "npm run generate:levels && devvit playtest",
    "editor": "npm run generate:levels && vite --config vite.editor.config.ts",
    "local": "npm run generate:levels && vite --config vite.local.config.ts",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test:types": "npm run generate:levels && tsc --build",
    "test:unit": "npm run generate:levels && node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7"
  }
}